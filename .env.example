# Local Supabase (values printed by `npx supabase start` / `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Used by scripts/seed-users.ts, never by app code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password for the demo logins created by scripts/seed-users.ts.
DEMO_USER_PASSWORD=choose-a-demo-password
